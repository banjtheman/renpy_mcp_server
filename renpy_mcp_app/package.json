{
  "name": "renpy-studio",
  "version": "1.0.0",
  "description": "Visual novel development studio for Claude Desktop - create Ren'Py games with AI-generated assets",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "renpy-studio": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "python",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "dev": "concurrently \"tsc -p tsconfig.server.json --watch\" \"vite build --watch\"",
    "serve": "node dist/main.js",
    "start": "npm run build && npm run serve",
    "dev:server": "tsx src/main.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "renpy",
    "visual-novel",
    "mcp",
    "mcp-app",
    "claude",
    "claude-desktop",
    "ai",
    "game-development",
    "gemini",
    "image-generation"
  ],
  "author": "Banjo Obayomi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banjtheman/renpy_mcp_server.git",
    "directory": "renpy_mcp_app"
  },
  "bugs": {
    "url": "https://github.com/banjtheman/renpy_mcp_server/issues"
  },
  "homepage": "https://github.com/banjtheman/renpy_mcp_server/tree/main/renpy_mcp_app#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "tar": "^7.4.3",
    "unzipper": "^0.12.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/crimson-text": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unzipper": "^0.10.10",
    "@vitejs/plugin-react": "^4.4.0",
    "@xyflow/react": "^12.4.0",
    "concurrently": "^9.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
